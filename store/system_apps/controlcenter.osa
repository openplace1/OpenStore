#app "Control Center"
#appColor "#5856D6"

# Quick controls as tiles: tap a tile to toggle it, drag the brightness bar,
# swipe up to close. Brightness sits at the top so the closing swipe from the
# bottom edge never runs through it.

while touch.down() == 1 do wait(20) end
wait(120)

var bright = getbright()
var accent = color.rgb(0, 122, 255)
var purple = color.rgb(88, 86, 214)
var green = color.rgb(52, 199, 89)

def drawTile(x, y, icon, label, sub, on, fillOn)
  var fill = theme.surface()
  if on == 1 then fill = fillOn end
  setcolor565(fill)
  smooth(1)
  rrect(x, y, 104, 84, 18)
  smooth(0)
  if on == 1 then
    setcolor(255, 255, 255)
    textcolor(255, 255, 255)
  else
    setcolor565(theme.text())
    textcolor565(theme.text())
  end
  ui.icon(icon, x + 26, y + 26, 26, fill)
  fontsize(2)
  textml(x + 12, y + 56, label)
  if on == 1 then textcolor(225, 232, 255) end
  if on == 0 then textcolor565(theme.subtext()) end
  fontsize(1)
  textml(x + 12, y + 72, sub)
end

def drawWifi()
  var on = wifi.isEnabled()
  var sub = "Off"
  if on == 1 then sub = "On" end
  if wifi.connected() == 1 then sub = wifi.ssid() end
  fontsize(1)
  drawTile(12, 132, "wifi", "Wi-Fi", textfit(sub, 84), on, accent)
end

def drawRestart()
  drawTile(124, 132, "power", "Restart", "Tap to reboot", 0, accent)
end

def drawTheme()
  var dark = theme()
  var sub = "Light"
  if dark == 1 then sub = "Dark" end
  drawTile(12, 224, "moon", "Theme", sub, dark, purple)
end

def drawSync(sub, on)
  drawTile(124, 224, "sync", "Time", sub, on, green)
end

def syncState()
  if time.synced() == 1 then return "Synced" end
  return "Tap to sync"
end

def drawBrightness()
  setcolor565(theme.surface())
  smooth(1)
  rrect(12, 48, 216, 72, 18)
  smooth(0)
  setcolor565(theme.text())
  ui.icon("sun", 36, 74, 24, theme.surface())
  textcolor565(theme.text())
  fontsize(2)
  textml(56, 74, "Brightness")
  textcolor565(theme.subtext())
  textmr(214, 74, str(int(bright * 100 / 255)) + "%")
  ui.progress(28, 96, 184, 12, bright - 10, 245)
end

def drawAll()
  bg565(theme.bg())
  fontsize(4)
  textcolor565(theme.text())
  text(16, 12, "Control Center")
  drawWifi()
  drawRestart()
  drawTheme()
  drawSync(syncState(), 0)
  drawBrightness()
end

drawAll()

loop
  if touch.tap(12, 132, 104, 84) == 1 then
    if wifi.isEnabled() == 1 then
      wifi.disable()
    else
      wifi.enable()
    end
    drawWifi()
  end
  if touch.tap(124, 132, 104, 84) == 1 then
    if ui.dialog("Restart OpenOS?", "Unsaved work in the current app is lost.", "Cancel", "Restart", 1) == 1 then
      sys.reboot()
    end
  end
  if touch.tap(12, 224, 104, 84) == 1 then
    sys.theme(1 - theme())
    drawAll()
  end
  if touch.tap(124, 224, 104, 84) == 1 then
    if wifi.connected() == 0 then
      drawSync("No Wi-Fi", 0)
    else
      drawSync("Syncing...", 1)
      if ntp.sync() == 1 then
        drawSync("Synced", 1)
      else
        drawSync("Sync failed", 0)
      end
    end
  end
  if touch.down() == 1 then
    if touch.in(12, 84, 216, 36) == 1 then
      var v = int((touch.x() - 28) * 245 / 184) + 10
      if v < 10 then v = 10 end
      if v > 255 then v = 255 end
      if v != bright then
        bright = v
        sys.brightness(bright)
        drawBrightness()
      end
    end
  end
  wait(20)
end
