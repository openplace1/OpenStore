#app "Home"
#isApp false

# OpenOS home screen — fully OSA. Loaded by main.cpp into osaApp whenever the
# device transitions to STATE_HOMESCREEN. Tap-launches via app.launch (then
# exit()), long-press opens the context menu, a held drag reorders/folds
# icons. Twelve tiles per page; swipe sideways to page, drag a tile to the
# screen edge to carry it to the next page.

wait(80)
while touch.down() == 1 do wait(20) end

var lastMin   = time.min()
var dragIdx   = -1
var dragX     = 0
var dragY     = 0
var pendingMv = -1
var page      = 0
var perPage   = 12
var edgeAt    = -1

def pageCount()
  var n = home.appCount()
  var p = int((n + perPage - 1) / perPage)
  if p < 1 then p = 1 end
  return p
end

def tileX(i)
  return home.iconX(i - page * perPage)
end

def tileY(i)
  return home.iconY(i - page * perPage)
end

def pageLast()
  var n = home.appCount()
  var last = page * perPage + perPage
  if last > n then last = n end
  return last
end

def gotoPage(p)
  if p < 0 then p = 0 end
  if p >= pageCount() then p = pageCount() - 1 end
  if p == page then return 0 end
  page = p
  return 1
end

# ─── Status bar (formerly Home::drawStatusBar in C++) ──────────────────────
# Theme-aware top strip: label, centered clock, battery indicator.
def drawStatus()
  var dark = theme()
  if dark == 1 then setcolor(20, 20, 22) end
  if dark == 0 then setcolor(245, 245, 247) end
  rect(0, 0, 240, 18)
  fontsize(2)
  if dark == 1 then textcolor(255, 255, 255) end
  if dark == 0 then textcolor(0, 0, 0) end
  text(5, 2, "CYD")
  textc(120, 9, time.fmtHM())
  if battery.available() == 0 then
    if dark == 1 then setcolor(255, 255, 255) end
    if dark == 0 then setcolor(0, 0, 0) end
    if dark == 1 then ui.icon("search", 228, 9, 13, color.rgb(20, 20, 22)) end
    if dark == 0 then ui.icon("search", 228, 9, 13, color.rgb(245, 245, 247)) end
  end
  # Battery indicator only when the firmware has a gauge configured
  # (battery_pin in config.ini); the stock CYD has none.
  if battery.available() == 1 then
    var pct = battery()
    textr(210, 2, str(pct) + "%")
    if dark == 1 then setcolor(255, 255, 255) end
    if dark == 0 then setcolor(0, 0, 0) end
    frame(215, 4, 16, 10)
    var fill = int(12 * pct / 100)
    if fill > 0 then rect(217, 6, fill, 6) end
    rect(231, 7, 2, 4)
  end
end

# ─── Helpers ────────────────────────────────────────────────────────────────
def hitTest(px, py)
  var last = pageLast()
  var i = page * perPage
  while i < last do
    var ix = tileX(i)
    var iy = tileY(i)
    if px >= ix and px <= ix + 46 and py >= iy and py <= iy + 46 then return i end
    i = i + 1
  end
  return -1
end

def drawTileAt(i, x, y)
  # Shadow
  setcolor(20, 20, 20)
  rrect(x + 2, y + 3, 46, 46, 12)
  # Tile background — use packed 565 directly from the native color.
  setcolor565(home.appColor(i))
  rrect(x, y, 46, 46, 12)
  # Built-in icon from the script's #appIcon header, if it has one.
  var ic = home.appIcon(i)
  if len(ic) > 0 then
    setcolor(255, 255, 255)
    ui.icon(ic, x + 23, y + 23, 26, home.appColor(i))
  end
  # Folder mini-grid (up to 4 children, 2x2). int() casts — OSA divides as
  # double so j/2 would be 0.5 for j=1 and the row would shift by 9 px.
  if home.appIsFolder(i) == 1 then
    var nf = home.folderCount(i)
    if nf > 4 then nf = 4 end
    var j = 0
    while j < nf do
      var mr = int(j / 2)
      var mc = j - mr * 2
      var mx = x + 6 + mc * 18
      var my = y + 6 + mr * 18
      setcolor565(home.folderAppColor(i, j))
      rrect(mx, my, 14, 14, 3)
      j = j + 1
    end
  end
  # Label (shadow + main)
  fontsize(2)
  textcolor(0, 0, 0)
  textc(x + 24, y + 61, home.appName(i))
  textcolor(255, 255, 255)
  textc(x + 23, y + 60, home.appName(i))
end

def drawTile(i)
  drawTileAt(i, tileX(i), tileY(i))
end

def drawDots()
  var count = pageCount()
  if count < 2 then return end
  var dark = theme()
  var x = 120 - (count - 1) * 7
  var p = 0
  while p < count do
    if p == page then
      if dark == 1 then setcolor(255, 255, 255) end
      if dark == 0 then setcolor(30, 30, 34) end
      circle(x, 292, 3)
    else
      if dark == 1 then setcolor(120, 120, 128) end
      if dark == 0 then setcolor(150, 150, 156) end
      circle(x, 292, 2)
    end
    x = x + 14
    p = p + 1
  end
end

def drawAll()
  if page >= pageCount() then page = pageCount() - 1 end
  wallpaper.draw()
  drawStatus()
  var last = pageLast()
  var i = page * perPage
  while i < last do
    if i != dragIdx then drawTile(i) end
    i = i + 1
  end
  drawDots()
end

# ─── Context menu ───────────────────────────────────────────────────────────
def ctxMenu(idx)
  var isF = home.appIsFolder(idx)
  var canRemove = home.canUninstall(idx)
  var btnCount = 3
  if isF == 1 then btnCount = 4 end
  if canRemove == 1 then btnCount = 4 end
  var btnH = 38
  var btnGap = 8
  var contentH = 52 + btnCount * btnH + (btnCount - 1) * btnGap + 14
  var boxX = 20
  var boxW = 200
  var boxY = (320 - contentH) / 2
  var btnX = boxX + 14
  var btnW = boxW - 28
  var firstBtnY = boxY + 52

  # Dim scanline backdrop
  setcolor(0, 0, 0)
  var rr = 0
  while rr < 320 do
    line(0, rr, 240, rr)
    rr = rr + 2
  end

  # Card
  setcolor(30, 30, 35)
  rrect(boxX, boxY, boxW, contentH, 14)
  setcolor(55, 55, 60)
  rframe(boxX, boxY, boxW, contentH, 14)
  fontsize(2)
  textcolor(160, 160, 165)
  textc(boxX + boxW / 2, boxY + 22, home.appName(idx))

  # Buttons
  var i = 0
  while i < btnCount do
    var by = firstBtnY + i * (btnH + btnGap)
    if i == 3 then setcolor(180, 60, 60) end
    if i != 3 then setcolor(28, 28, 32) end
    rrect(btnX, by, btnW, btnH, 8)
    setcolor(45, 45, 50)
    rframe(btnX, by, btnW, btnH, 8)
    textcolor(255, 255, 255)
    var lbl = "Open"
    if i == 1 then lbl = "Move" end
    if i == 2 then lbl = "Create folder..." end
    if i == 3 and isF == 1 then lbl = "Delete folder" end
    if i == 3 and isF == 0 then lbl = "Uninstall" end
    textc(btnX + btnW / 2, by + btnH / 2, lbl)
    i = i + 1
  end

  while touch.down() == 1 do wait(20) end
  wait(120)

  while 1 == 1 do
    if touch.down() == 1 then
      var tx = touch.x()
      var ty = touch.y()
      var k = 0
      while k < btnCount do
        var by = firstBtnY + k * (btnH + btnGap)
        if tx >= btnX and tx <= btnX + btnW and ty >= by and ty <= by + btnH then
          while touch.down() == 1 do wait(20) end
          return k
        end
        k = k + 1
      end
      if tx < boxX or tx > boxX + boxW or ty < boxY or ty > boxY + contentH then
        while touch.down() == 1 do wait(20) end
        return -1
      end
    end
    wait(20)
  end
end

# ─── Folder modal view (3-column grid of contained apps) ────────────────────
# All grid math uses int() because OSA division returns a double — without it
# row 1 would render at y = ~74 instead of y = 50 + cellH.
def folderView(idx)
  bg(10, 10, 16)
  fontsize(2)
  textcolor(255, 255, 255)
  textc(120, 22, home.appName(idx))
  var n = home.folderCount(idx)
  var cols = 3
  var cellW = 60
  var cellH = 72
  var startX = int((240 - cols * cellW) / 2)
  var startY = 50
  var i = 0
  while i < n do
    var col = i - int(i / cols) * cols
    var row = int(i / cols)
    var x = startX + col * cellW + int((cellW - 46) / 2)
    var y = startY + row * cellH
    setcolor(0, 0, 0)
    rrect(x + 2, y + 3, 46, 46, 12)
    setcolor565(home.folderAppColor(idx, i))
    rrect(x, y, 46, 46, 12)
    var fic = home.folderAppIcon(idx, i)
    if len(fic) > 0 then
      setcolor(255, 255, 255)
      ui.icon(fic, x + 23, y + 23, 26, home.folderAppColor(idx, i))
    end
    fontsize(2)
    textcolor(0, 0, 0)
    textc(x + 24, y + 61, home.folderAppName(idx, i))
    textcolor(255, 255, 255)
    textc(x + 23, y + 60, home.folderAppName(idx, i))
    i = i + 1
  end
  fontsize(1)
  textcolor(140, 140, 160)
  textc(120, 305, "Tap outside or swipe up to close")

  while touch.down() == 1 do wait(20) end
  wait(120)

  var rows = int((n + cols - 1) / cols)
  var gridBottom = startY + rows * cellH
  while 1 == 1 do
    if touch.down() == 1 then
      var tx = touch.x()
      var ty = touch.y()
      var j = 0
      while j < n do
        var col = j - int(j / cols) * cols
        var row = int(j / cols)
        var x = startX + col * cellW + int((cellW - 46) / 2)
        var y = startY + row * cellH
        if tx >= x and tx <= x + 46 and ty >= y and ty <= y + 46 then
          while touch.down() == 1 do wait(20) end
          anim.openAt(x, y, home.folderAppColor(idx, j))
          app.launch(home.folderAppPath(idx, j))
          exit()
        end
        j = j + 1
      end
      if ty < startY or ty > gridBottom or tx < startX or tx > startX + cols * cellW then
        while touch.down() == 1 do wait(20) end
        return 0
      end
    end
    wait(25)
  end
end

# ─── App drawer with search ─────────────────────────────────────────────────
# matchAt(k, want) walks tiles and folder children in order and returns the
# k-th one whose name contains the query: want 0 name, 1 path, 2 colour,
# 3 icon; -1 for the count.
var query = ""

def matchAt(k, want)
  var q = lower(query)
  var n = home.appCount()
  var seen = 0
  var i = 0
  while i < n do
    if home.appIsFolder(i) == 1 then
      var nf = home.folderCount(i)
      var j = 0
      while j < nf do
        if len(q) == 0 or contains(lower(home.folderAppName(i, j)), q) == 1 then
          if seen == k then
            if want == 0 then return home.folderAppName(i, j) end
            if want == 1 then return home.folderAppPath(i, j) end
            if want == 2 then return home.folderAppColor(i, j) end
            return home.folderAppIcon(i, j)
          end
          seen = seen + 1
        end
        j = j + 1
      end
    else
      if len(q) == 0 or contains(lower(home.appName(i)), q) == 1 then
        if seen == k then
          if want == 0 then return home.appName(i) end
          if want == 1 then return home.appPath(i) end
          if want == 2 then return home.appColor(i) end
          return home.appIcon(i)
        end
        seen = seen + 1
      end
    end
    i = i + 1
  end
  if want == -1 then return seen end
  return ""
end

def drawDrawer(first)
  bg565(theme.bg())
  ui.backHeader("All apps")
  ui.card(12, 58, 216, 36, 18)
  setcolor565(theme.subtext())
  ui.icon("search", 32, 76, 18, theme.surface())
  fontsize(2)
  if len(query) > 0 then
    textcolor565(theme.text())
    textml(48, 76, textfit(query, 150))
  else
    textcolor565(theme.hint())
    textml(48, 76, "Search apps")
  end
  var total = matchAt(0, -1)
  var row = 0
  while row < 6 and first + row < total do
    var k = first + row
    var y = 102 + row * 36
    setcolor565(matchAt(k, 2))
    smooth(1)
    rrect(18, y, 28, 28, 8)
    smooth(0)
    var ic = matchAt(k, 3)
    if len(ic) > 0 then
      setcolor(255, 255, 255)
      ui.icon(ic, 32, y + 14, 16, matchAt(k, 2))
    end
    fontsize(2)
    textcolor565(theme.text())
    textml(56, y + 14, textfit(matchAt(k, 0), 160))
    row = row + 1
  end
  if total == 0 then
    fontsize(2)
    textcolor565(theme.hint())
    textc(120, 150, "No apps match")
  end
  if total > first + 6 then
    fontsize(1)
    textcolor565(theme.hint())
    textc(120, 312, "swipe up for more")
  end
end

def drawerView()
  var first = 0
  drawDrawer(first)
  while 1 == 1 do
    if touch.down() == 1 and ui.backTapped() == 1 then
      while touch.down() == 1 do wait(20) end
      return
    end
    if touch.tap(12, 58, 216, 36) == 1 then
      query = input("Search apps", query)
      first = 0
      drawDrawer(first)
    end
    if touch.tap(12, 102, 216, 216) == 1 then
      var k = first + int((touch.endY() - 102) / 36)
      if k < matchAt(0, -1) then
        var color = matchAt(k, 2)
        anim.openAt(18, 102 + (k - first) * 36 - 9, color)
        app.launch(matchAt(k, 1))
        exit()
      end
    end
    if gesture.swipeUp() == 1 then
      if first + 6 < matchAt(0, -1) then
        first = first + 6
        drawDrawer(first)
      end
    end
    if gesture.swipeDown() == 1 then
      if first > 0 then
        first = first - 6
        if first < 0 then first = 0 end
        drawDrawer(first)
      end
    end
    wait(25)
  end
end

# ─── Main interaction loop ──────────────────────────────────────────────────
drawAll()

loop
  # Idle: redraw status bar on minute change.
  if touch.down() == 0 then
    if time.min() != lastMin then
      lastMin = time.min()
      drawStatus()
    end
    wait(35)
  end

  if touch.down() == 1 then
    var sx = touch.x()
    var sy = touch.y()
    if sy < 18 and sx > 196 then
      while touch.down() == 1 do wait(20) end
      drawerView()
      drawAll()
      sx = -1
      sy = -1
    end
    var idx = hitTest(sx, sy)
    var t0 = millis()
    var mode = 0  # 0=undecided, 1=drag, 2=menu_done, 3=swipe
    var cx = sx
    var cy = sy
    edgeAt = -1

    # Wait while finger is down — decide gesture.
    while touch.down() == 1 do
      cx = touch.x()
      cy = touch.y()

      # Long-press 1s -> open context menu
      if mode == 0 then
        if idx >= 0 then
          if millis() - t0 > 1000 then
            mode = 2
            var pick = ctxMenu(idx)
            if pick == 0 then
              # Open (works for both apps and folders)
              if home.appIsFolder(idx) == 1 then
                folderView(idx)
              end
              if home.appIsFolder(idx) == 0 then
                anim.openAt(tileX(idx), tileY(idx), home.appColor(idx))
                app.launch(home.appPath(idx))
                exit()
              end
              drawAll()
            end
            if pick == 1 then
              pendingMv = idx
              notify("Tap target to swap")
              notify("Tap a folder to move into it")
              drawAll()
            end
            if pick == 2 then
              var made = home.makeFolder(idx)
              if made == 1 then notify("Created folder") end
              if made == 0 then ui.alert("Folder", "Not enough memory to create the folder.") end
              drawAll()
            end
            if pick == 3 then
              var removingFolder = home.appIsFolder(idx)
              if removingFolder == 1 then
                var deleted = home.deleteFolder(idx)
                if deleted == 1 then notify("Deleted folder") end
                if deleted == 0 then ui.alert("Folder not deleted", "There are not enough free Home slots for its apps.") end
              end
              if removingFolder == 0 then
                var removedName = home.appName(idx)
                var removed = home.uninstall(idx)
                if removed == 1 then notify("Uninstalled " + removedName) end
              end
              drawAll()
            end
          end
        end
      end

      # Movement past 18 px: a tile held for a moment starts a drag, a quick
      # sideways move anywhere is a page swipe.
      if mode == 0 then
        var ddx = cx - sx
        var ddy = cy - sy
        if ddx < 0 then ddx = 0 - ddx end
        if ddy < 0 then ddy = 0 - ddy end
        if ddx > 18 or ddy > 18 then
          if idx >= 0 and millis() - t0 >= 260 then
            mode = 1
            dragIdx = idx
          elif ddx > ddy then
            mode = 3
          end
        end
      end

      # Drag rendering — full redraw + dragged tile under finger. Holding
      # the tile at a screen edge carries it to the neighbouring page.
      if mode == 1 then
        if cx != dragX or cy != dragY then
          dragX = cx
          dragY = cy
          drawAll()
          drawTileAt(idx, cx - 23, cy - 23)
        end
        if cx < 14 or cx > 226 then
          if edgeAt < 0 then edgeAt = millis() end
          if millis() - edgeAt > 450 then
            edgeAt = -1
            var target = page + 1
            if cx < 14 then target = page - 1 end
            if target >= 0 and target < pageCount() then
              home.move(idx, target * perPage)
              home.saveOrder()
              idx = target * perPage
              dragIdx = idx
              page = target
              drawAll()
              drawTileAt(idx, cx - 23, cy - 23)
              var stay = 1
              while stay == 1 do
                if touch.down() == 0 then stay = 0 end
                if touch.x() >= 14 and touch.x() <= 226 then stay = 0 end
                wait(20)
              end
            end
          end
        else
          edgeAt = -1
        end
      end

      wait(15)
    end

    # Touch released — decide outcome.
    if mode == 3 then
      var moved = cx - sx
      if moved < -40 then
        if gotoPage(page + 1) == 1 then drawAll() end
      end
      if moved > 40 then
        if gotoPage(page - 1) == 1 then drawAll() end
      end
    end
    if mode == 1 then
      # Drag drop — onto a tile swaps or folds, onto empty space of this page
      # moves the tile to the page's last slot.
      var drop = hitTest(dragX, dragY)
      if drop >= 0 then
        if drop != idx then
          if home.appIsFolder(drop) == 1 then
            home.addToFolder(drop, idx)
          end
          if home.appIsFolder(drop) == 0 then
            home.swap(idx, drop)
          end
          home.saveOrder()
        end
      else
        if dragY > 24 and dragY < 280 then
          var slot = pageLast() - 1
          if slot != idx then
            home.move(idx, slot)
            home.saveOrder()
          end
        end
      end
      dragIdx = -1
      drawAll()
    end
    if mode == 0 then
      # Tap (no drag, no long-press) — launch or fulfill pending move.
      if idx >= 0 then
        if pendingMv >= 0 then
          var src = pendingMv
          pendingMv = -1
          if idx == src then
            notify("Move cancelled")
          end
          if idx != src then
            if home.appIsFolder(idx) == 1 then
              var moved = home.addToFolder(idx, src)
              if moved == 1 then notify("Moved into folder") end
              if moved == 0 then ui.alert("Move failed", "The folder is full or memory is low.") end
            end
            if home.appIsFolder(idx) == 0 then
              home.swap(src, idx)
              notify("Swapped")
            end
            home.saveOrder()
          end
          drawAll()
        end
        if pendingMv == -1 then
          if home.appIsFolder(idx) == 1 then
            folderView(idx)
            drawAll()
          end
          if home.appIsFolder(idx) == 0 then
            anim.openAt(tileX(idx), tileY(idx), home.appColor(idx))
            app.launch(home.appPath(idx))
            exit()
          end
        end
      end
    end
  end
end
