#app "Compiler"
#isApp true
#appColor "#8E8E93"

# Compiles a .osa script on the SD card to a binary .osac. The .osac
# carries opcodes + constant pools — no source — so it can ship without
# revealing the original script. Privileged because osa.compile() writes
# arbitrary paths via the fs.* APIs.

wait(120)
while touch.down() == 1 do wait(20) end

def parentDir(path)
  if path == "/" then return "/" end
  var i = len(path) - 1
  while i > 0 do
    if substr(path, i, 1) == "/" then return substr(path, 0, i) end
    i = i - 1
  end
  return "/"
end

def joinPath(dir, name)
  if dir == "/" then return "/" + name end
  return dir + "/" + name
end

# Recursively lists every .osa file under the SD root one level deep.
var curDir = "/"

loop
  ui.menuStart("Compiler — " + curDir, 1)
  ui.menuRow("/", "/", 100, 100, 100, "go to root")
  ui.menuRow("..", "U", 120, 120, 120, "up")
  var entries = fs.list(curDir)
  var i = 0
  var hits = 2
  while i < 32 do
    var name = split(entries, "|", i)
    if len(name) == 0 then break end
    var isDir = endswith(name, "/")
    var lower = lower(name)
    if isDir == 1 then
      ui.menuRow(name, "D", 0, 120, 255, "folder")
      hits = hits + 1
    end
    if isDir == 0 then
      if endswith(lower, ".osa") == 1 then
        ui.menuRow(name, "C", 52, 199, 89, "tap to compile")
        hits = hits + 1
      end
    end
    i = i + 1
  end
  var pick = ui.menuShow()
  if pick == -1 then exit() end
  if pick == 0 then curDir = "/" continue end
  if pick == 1 then curDir = parentDir(curDir) continue end

  # Map pick back to entry name.
  var j = 0
  var matched = ""
  var k = 0
  while k < 32 do
    var nm = split(entries, "|", k)
    if len(nm) == 0 then break end
    var isd = endswith(nm, "/")
    var lw  = lower(nm)
    var counts = 0
    if isd == 1 then counts = 1 end
    if isd == 0 then
      if endswith(lw, ".osa") == 1 then counts = 1 end
    end
    if counts == 1 then
      if j == pick - 2 then matched = nm break end
      j = j + 1
    end
    k = k + 1
  end
  if len(matched) == 0 then continue end

  if endswith(matched, "/") == 1 then
    var bare = substr(matched, 0, len(matched) - 1)
    curDir = joinPath(curDir, bare)
    continue
  end

  # Compile picked .osa into .osac next to it.
  var src = joinPath(curDir, matched)
  var dst = substr(src, 0, len(src) - 4) + ".osac"
  var ok = osa.compile(src, dst)
  if ok == 1 then
    ui.alert("Compiled", "Wrote " + dst)
  end
  if ok == 0 - 1 then
    ui.alert("Failed", "Permission denied")
  end
  if ok == 0 - 2 then
    ui.alert("Failed", "Out of memory (alloc failed)")
  end
  if ok == 0 - 3 then
    ui.alert("Failed", "Could not read " + matched)
  end
  if ok == 0 - 4 then
    ui.alert("Failed", "Bytecode bailed — script has features not yet supported (return in inline-if, inline forms, etc)")
  end
  if ok == 0 - 5 then
    ui.alert("Failed", "Could not write " + dst)
  end
  if ok == 0 - 6 then
    ui.alert("Failed", "Bytecode exceeds 8192 bytes")
  end
  if ok == 0 - 7 then
    ui.alert("Failed", "Too many numeric constants")
  end
  if ok == 0 - 8 then
    ui.alert("Failed", "Too many string constants")
  end
  if ok == 0 - 9 then
    ui.alert("Failed", "Too many identifiers")
  end
  if ok == 0 - 10 then
    ui.alert("Failed", "Invalid bytecode jump")
  end
end
