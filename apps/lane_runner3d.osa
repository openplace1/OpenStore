#app "Lane Runner 3D"
#isApp true
#appColor "#FF9F0A"

# Tap the left or right half of the screen to change lane and avoid the
# incoming red cube for as long as possible.
#
# Full screen at 16-bit colour: the road and both cubes go into one scene
# per frame and d3.present renders it through a 240x40 band buffer. The
# score strip at the top and the lane buttons at the bottom stay outside the
# 3D viewport, so they are drawn once and survive the band pushes.

while touch.down() == 1 do
  wait(10)
end
wait(80)

if sdk.has("d3.scene") == 0 then
  ui.alert("Update required", "Lane Runner 3D needs OpenOS 1.5.")
  exit()
end

var hudH = 28
var barH = 52
var barY = 320 - barH
var playerLane = 0
var playerX = 0
var obstacleLane = 0
var obstacleX = 0
var obstacleZ = 13
var obstacleSpin = 0
var speed = 0.16
var score = 0
var best = 0
var gameOver = 0
var fps = 30
var gridZ = 0
var shownScore = -1

var spriteDepth = gfx.auto(240, 40, 16)
if spriteDepth == 0 then
  ui.alert("Not enough RAM", "Could not allocate the band buffer.")
  exit()
end

d3.reset()
d3.camera(120, hudH + 128, 138, 5)
d3.viewport(0, hudH, 240, 320 - hudH - barH)
d3.background(color.rgb(18, 24, 42))
d3.light(-0.3, -0.7, -0.65, 0.34)

def newObstacle()
  obstacleLane = random(-1, 2)
  obstacleX = obstacleLane * 1.75
  obstacleZ = 13
  obstacleSpin = random(0, 628) / 100
end

def resetGame()
  playerLane = 0
  playerX = 0
  speed = 0.16
  score = 0
  gameOver = 0
  newObstacle()
end

def drawHud()
  gfx.stash()
  setcolor(5, 7, 14)
  rect(0, 0, 240, hudH)
  textcolor(240, 245, 255)
  fontsize(2)
  text(8, 6, "SCORE " + str(score))
  textcolor(145, 165, 195)
  textr(232, 6, "BEST " + str(best))
  gfx.unstash()
  shownScore = score
end

def drawButtons()
  gfx.stash()
  setcolor(5, 7, 14)
  rect(0, barY, 240, barH)
  setcolor(25, 35, 58)
  smooth(1)
  rrect(14, barY + 8, 100, 38, 12)
  rrect(126, barY + 8, 100, 38, 12)
  smooth(0)
  setcolor(220, 230, 245)
  ui.icon("back", 64, barY + 27, 20, color.rgb(25, 35, 58))
  path.begin()
  path.to(170, barY + 19)
  path.to(180, barY + 27)
  path.to(170, barY + 35)
  path.stroke(2, 0)
  gfx.unstash()
end

def drawScene()
  d3.begin()
  setcolor(48, 65, 92)
  d3.line(-2.7, -2.0, -1.2, -2.7, -2.0, 15)
  d3.line(-0.88, -2.0, -1.2, -0.88, -2.0, 15)
  d3.line(0.88, -2.0, -1.2, 0.88, -2.0, 15)
  d3.line(2.7, -2.0, -1.2, 2.7, -2.0, 15)
  gridZ = -1
  while gridZ <= 14 do
    d3.line(-2.7, -2.0, gridZ, 2.7, -2.0, gridZ)
    gridZ = gridZ + 3
  end
  setcolor(255, 69, 58)
  d3.cube(obstacleX, -1.35, obstacleZ, 1.05, obstacleSpin, obstacleSpin * 0.7, 0, 2)
  setcolor(48, 209, 88)
  d3.cube(playerX, -1.35, -0.45, 1.05, 0.08, -0.2, 0, 2)
  d3.present()
end

def drawCrash()
  gfx.stash()
  setcolor(9, 13, 24)
  rrect(40, 130, 160, 80, 14)
  textcolor(255, 105, 97)
  fontsize(4)
  textc(120, 158, "CRASHED")
  textcolor(225, 233, 245)
  fontsize(1)
  textc(120, 192, "Tap to retry")
  gfx.unstash()
end

newObstacle()
drawHud()
drawButtons()

loop
  if gameOver == 0 then
    if touch.tap(0, hudH, 120, 320 - hudH) == 1 then
      playerLane = playerLane - 1
      if playerLane < -1 then
        playerLane = -1
      end
    end
    if touch.tap(120, hudH, 120, 320 - hudH) == 1 then
      playerLane = playerLane + 1
      if playerLane > 1 then
        playerLane = 1
      end
    end

    playerX = approach(playerX, playerLane * 1.75, 0.22)
    obstacleZ = obstacleZ - speed
    obstacleSpin = obstacleSpin + 0.045

    if obstacleZ < 1.0 and obstacleZ > -1.0 then
      if obstacleLane == playerLane then
        gameOver = 1
        if score > best then
          best = score
        end
      end
    end

    if obstacleZ <= -1.2 then
      score = score + 1
      if score > best then
        best = score
      end
      speed = min(0.31, 0.16 + score * 0.006)
      newObstacle()
    end

    drawScene()
    if score != shownScore then drawHud() end
    if gameOver == 1 then
      # The last frame stays on screen under the panel; nothing is
      # rendered again until the game restarts.
      drawHud()
      drawCrash()
    end
    fps = d3.frame(30)
  else
    if touch.tap(0, 0, 240, 320) == 1 then
      resetGame()
      drawHud()
    end
    wait(30)
  end
end
