#app "Snake"
#appColor "#00C853"
#isApp true

# ---- Config ----
var cell = 20
var cols = 12
var rows = 16
var maxlen = 192

# snake stored as parallel arrays (head at index 0)
var sx0 = 0
var sy0 = 0
var snakeX = ""
var snakeY = ""
var len = 3
var dirX = 1
var dirY = 0
var pendDirX = 1
var pendDirY = 0

var foodX = 0
var foodY = 0
var score = 0
var alive = 1
var tick = 0
var speed = 6

# ---- Helpers: store coords as pipe-separated strings ----
def getX(i)
    return num(split(snakeX, "|", i))
end

def getY(i)
    return num(split(snakeY, "|", i))
end

def pushFront(x, y)
    if len == 0 then
        snakeX = str(x)
        snakeY = str(y)
    else
        snakeX = str(x) + "|" + snakeX
        snakeY = str(y) + "|" + snakeY
    end
end

def dropLast()
    var out = ""
    var i = 0
    while i < len - 1 do
        var v = split(snakeX, "|", i)
        if i == 0 then
            out = v
        else
            out = out + "|" + v
        end
        i = i + 1
    end
    snakeX = out

    out = ""
    i = 0
    while i < len - 1 do
        var v = split(snakeY, "|", i)
        if i == 0 then
            out = v
        else
            out = out + "|" + v
        end
        i = i + 1
    end
    snakeY = out
end

def occupied(x, y)
    var i = 0
    while i < len do
        if getX(i) == x then
            if getY(i) == y then
                return 1
            end
        end
        i = i + 1
    end
    return 0
end

def placeFood()
    var placed = 0
    while placed == 0 do
        var fx = random(0, cols)
        var fy = random(0, rows)
        if occupied(fx, fy) == 0 then
            foodX = fx
            foodY = fy
            placed = 1
        end
    end
end

def resetGame()
    len = 3
    dirX = 1
    dirY = 0
    pendDirX = 1
    pendDirY = 0
    snakeX = "5|4|3"
    snakeY = "7|7|7"
    score = 0
    alive = 1
    tick = 0
    placeFood()
end

# ---- Drawing ----
def drawGrid()
    cls()
    setcolor(18, 18, 20)
    rect(0, 0, screenw(), screenh())
end

def drawCell(gx, gy, r, g, b)
    setcolor(r, g, b)
    rrect(gx * cell + 1, gy * cell + 1, cell - 2, cell - 2, 3)
end

def drawSnake()
    var i = 0
    while i < len do
        if i == 0 then
            drawCell(getX(i), getY(i), 0, 230, 130)
        else
            drawCell(getX(i), getY(i), 0, 170, 90)
        end
        i = i + 1
    end
end

def drawFood()
    setcolor(255, 80, 80)
    circle(foodX * cell + int(cell / 2), foodY * cell + int(cell / 2), int(cell / 2) - 2)
end

def drawHud()
    textcolor(255, 255, 255)
    fontsize(2)
    text(4, screenh() - 16, "Score: " + str(score))
end

def drawGameOver()
    setcolor(0, 0, 0)
    rect(20, 120, 200, 90)
    setcolor(255, 60, 60)
    rframe(20, 120, 200, 90, 8)
    textcolor(255, 255, 255)
    fontsize(2)
    textc(120, 150, "Game Over")
    textc(120, 175, "Score: " + str(score))
    textcolor(180, 180, 180)
    textc(120, 195, "Tap to restart")
end

# ---- Input ----
def readInput()
    if gesture.swipeUp() then
        if dirY == 0 then
            pendDirX = 0
            pendDirY = -1
        end
    end
    if gesture.swipeDown() then
        if dirY == 0 then
            pendDirX = 0
            pendDirY = 1
        end
    end
    if gesture.swipeLeft() then
        if dirX == 0 then
            pendDirX = -1
            pendDirY = 0
        end
    end
    if gesture.swipeRight() then
        if dirX == 0 then
            pendDirX = 1
            pendDirY = 0
        end
    end
end

# ---- Game step ----
def step()
    dirX = pendDirX
    dirY = pendDirY

    var headX = getX(0)
    var headY = getY(0)
    var nx = headX + dirX
    var ny = headY + dirY

    if nx < 0 then
        alive = 0
        return 0
    end
    if nx >= cols then
        alive = 0
        return 0
    end
    if ny < 0 then
        alive = 0
        return 0
    end
    if ny >= rows then
        alive = 0
        return 0
    end

    var willEat = 0
    if nx == foodX then
        if ny == foodY then
            willEat = 1
        end
    end

    if willEat == 0 then
        if occupied(nx, ny) then
            alive = 0
            return 0
        end
    end

    pushFront(nx, ny)

    if willEat == 1 then
        len = len + 1
        score = score + 10
        if len < maxlen then
            placeFood()
        end
    else
        dropLast()
    end

    return 1
end

# ---- Main ----
resetGame()

loop
    if alive == 1 then
        readInput()

        tick = tick + 1
        if tick >= speed then
            tick = 0
            step()
        end

        drawGrid()
        drawFood()
        drawSnake()
        drawHud()

        if gesture.swipeUp() then
        elif gesture.swipeDown() then
        end
    else
        drawGameOver()
        if touch.released() then
            resetGame()
        end
    end

    wait(30)
end
