#app "Clicker Test"
#appColor "#1E1E24"
#isApp true

# Global state
var count = 0

# Button geometry configuration
var btnW = 52
var btnH = 42
var btnY = 230

# X coordinates for horizontal button alignment
var btnMinusX = 25
var btnPlusX  = 94
var btnMultX  = 163

loop
    # 1. Clear screen with current theme background
    cls()
    
    # Render standard system header
    ui.header("Clicker Test Utility")
    
    # 2. Display current counter state centered on screen
    textcolor565(theme.text())
    fontsize(4)
    textc(120, 125, str(count))
    
    # 3. Render Decrement Button (-)
    setcolor(211, 47, 47) 
    rrect(btnMinusX, btnY, btnW, btnH, 6)
    textcolor(255, 255, 255)
    fontsize(2)
    textc(btnMinusX + 26, btnY + 21, "-")
    
    # 4. Render Increment Button (+)
    setcolor(56, 142, 60)
    rrect(btnPlusX, btnY, btnW, btnH, 6)
    textcolor(255, 255, 255)
    fontsize(2)
    textc(btnPlusX + 26, btnY + 21, "+")
    
    # 5. Render Multiplier Button (*2)
    setcolor(25, 118, 210)
    rrect(btnMultX, btnY, btnW, btnH, 6)
    textcolor(255, 255, 255)
    fontsize(2)
    textc(btnMultX + 26, btnY + 21, "*2")
    
    # 6. Touch Event Processing Pipeline
    if touch.released() then
        var tx = touch.x()
        var ty = touch.y()
        
        # Validate vertical touch boundaries
        if ty >= btnY and ty <= btnY + btnH then
            # Handle minus tap
            if tx >= btnMinusX and tx <= btnMinusX + btnW then
                count = count - 1
            # Handle plus tap
            elif tx >= btnPlusX and tx <= btnPlusX + btnW then
                count = count + 1
            # Handle multiply tap
            elif tx >= btnMultX and tx <= btnMultX + btnW then
                count = count * 2
            end
        end
    end
    
    # Main loop throttling for power efficiency and CPU stability
    wait(20)
end